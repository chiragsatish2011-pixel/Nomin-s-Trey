{
  "name": "trey-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Trey for Windows — Intelligent Focus Companion by Nomin",
  "author": "Chirag S <chiragsatish2011-pixel@users.noreply.github.com>",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@nomin/desktop run dev",
    "build": "npm run build --workspaces",
    "test": "npm --workspace=@nomin/core run test",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "package": "npm --workspace=@nomin/desktop run package",
    "installer": "npm --workspace=@nomin/desktop run installer"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "uiohook-napi@1.5.5": true,
    "electron-winstaller@5.4.0": true
  }
}
